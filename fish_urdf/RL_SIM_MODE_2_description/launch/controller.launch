<launch>

<rosparam file="$(find RL_SIM_MODE_2_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="RL_SIM_MODE_2" args="È¸Àü 3_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/RL_SIM_MODE_2/joint_states"/>
</node>

</launch>